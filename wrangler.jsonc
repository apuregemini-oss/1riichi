{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riichi-night-ledger",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./dist", "binding":"ASSETS", "not_found_handling":"single-page-application", "run_worker_first":["/api/*","/admin","/admin/*"]},
  "d1_databases": [{"binding":"DB","database_name":"riichi-night-ledger","database_id":"00000000-0000-0000-0000-000000000000"}],
  "vars": {"OWNER_EMAIL":"", "ACCESS_TEAM_DOMAIN":"", "ACCESS_AUD":""}
}
